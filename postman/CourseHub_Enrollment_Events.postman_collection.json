{
  "info": {
    "name": "CourseHub - Enrollment events - Bài 1",
    "description": "10 request có/không dữ liệu, lọc, phân trang ổn định và validation. Chạy cùng python -m backend.tests.postman_demo --port 8011 để có fixture xác định, CSDL gốc không bị thay đổi. Dừng server bằng Ctrl+C để dọn schema thử.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8011",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Có dữ liệu, thứ tự ổn định",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/enrollment-events?student_id=22000001&skip=0&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "enrollment-events"
          ],
          "query": [
            {
              "key": "student_id",
              "value": "22000001"
            },
            {
              "key": "skip",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 và JSON\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.response.to.be.json;",
              "});",
              "const rows = pm.response.json();",
              "pm.test(\"Đúng toàn bộ fixture được mong đợi\", function () {",
              "    const expected = [{\"id\":3,\"student_id\":\"22000001\",\"class_section_id\":\"WEB-01\",\"event_type\":\"CREATED\",\"source\":\"postman-bai1\",\"dataset\":\"demo\",\"occurred_at\":\"2026-11-02T00:00:00\"},{\"id\":2,\"student_id\":\"22000001\",\"class_section_id\":\"WEB-01\",\"event_type\":\"CANCELLED\",\"source\":\"postman-bai1\",\"dataset\":\"demo\",\"occurred_at\":\"2026-11-02T00:00:00\"},{\"id\":1,\"student_id\":\"22000001\",\"class_section_id\":\"WEB-01\",\"event_type\":\"CREATED\",\"source\":\"postman-bai1\",\"dataset\":\"demo\",\"occurred_at\":\"2026-11-01T00:00:00\"}];",
              "    pm.expect(rows).to.be.an(\"array\");",
              "    pm.expect(rows).to.eql(expected);",
              "});",
              "pm.test(\"occurred_at DESC, id DESC\", function () {",
              "    for (let i = 1; i < rows.length; i++) {",
              "        const previous = rows[i - 1];",
              "        const current = rows[i];",
              "        const previousTime = Date.parse(previous.occurred_at);",
              "        const currentTime = Date.parse(current.occurred_at);",
              "        pm.expect(previousTime).to.be.at.least(currentTime);",
              "        if (previousTime === currentTime) {",
              "            pm.expect(previous.id).to.be.greaterThan(current.id);",
              "        }",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
